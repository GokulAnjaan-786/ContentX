# ==============================================================================
# ContentForge AI - Production Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # Options: development, staging, production, testing
DEBUG=true                             # Set to false in production
APP_NAME="ContentForge AI"
API_V1_STR=/api/v1
DOMAIN_NAME=localhost                  # VPS domain (e.g. contentforge.ai)

# ------------------------------------------------------------------------------
# 2. Security, Authentication & Cryptography
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret key for JWT signing
# Generate via: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. Dynamic Rate Limiting (SlowAPI)
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_UPLOAD="10/hour"            # Per-user document upload limit
RATE_LIMIT_GENERATE="20/hour"          # Per-user AI generation limit

# ------------------------------------------------------------------------------
# 4. Data Retention & Privacy (Part 4)
# ------------------------------------------------------------------------------
DATA_RETENTION_DAYS=90                 # Auto-purge raw storage files older than 90 days

# ------------------------------------------------------------------------------
# 5. Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=contentforge
POSTGRES_PASSWORD=contentforge_secret_pw
POSTGRES_DB=contentforge_db
DATABASE_URL=postgresql://contentforge:contentforge_secret_pw@postgres:5432/contentforge_db

# ------------------------------------------------------------------------------
# 6. Redis & Celery Asynchronous Workers
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 7. Object Storage (MinIO / S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=contentforge-documents
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 8. ClamAV Antivirus Scanner
# ------------------------------------------------------------------------------
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# ------------------------------------------------------------------------------
# 9. Document Chunking & Ingestion Settings
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=20971520         # 20 MB max file size
CHUNK_SIZE_TARGET=600                  # Words per chunk
CHUNK_OVERLAP=50                       # Words overlapping between chunks

# ------------------------------------------------------------------------------
# 10. AI Model Inference & Embeddings (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120
EMBEDDING_MODEL=BAAI/bge-m3
RAG_CONTEXT_TOKEN_LIMIT=6000

# ------------------------------------------------------------------------------
# 11. Monitoring, Metrics & Observability (Part 4)
# ------------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
SENTRY_DSN=""                          # Optional Sentry DSN: e.g. https://xxx@yyy.ingest.sentry.io/zzz
GRAFANA_ADMIN_PASSWORD=admin123        # Change in production

# ------------------------------------------------------------------------------
# 12. Frontend Next.js Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# HASHICORP VAULT SWAP INSTRUCTIONS (Production Secret Management)
# ==============================================================================
# In staging/production, you can replace .env static secrets with HashiCorp Vault.
# 1. Install hvac in backend (pip install hvac)
# 2. Set VAULT_ADDR and VAULT_TOKEN in environment:
#      VAULT_ADDR="https://vault.yourdomain.com:8200"
#      VAULT_TOKEN="s.YourVaultTokenHere"
# 3. Read secrets at runtime in backend/app/core/config.py:
#      import hvac
#      client = hvac.Client(url=os.getenv("VAULT_ADDR"), token=os.getenv("VAULT_TOKEN"))
#      secret = client.secrets.kv.v2.read_secret_version(path='contentforge/prod')
#      SECRET_KEY = secret['data']['data']['SECRET_KEY']
#      POSTGRES_PASSWORD = secret['data']['data']['POSTGRES_PASSWORD']
